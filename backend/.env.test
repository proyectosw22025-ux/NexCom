NODE_ENV=test
PORT=4000

DATABASE_URL=postgresql://test:test@localhost:5432/nexcom_test
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=test_access_secret_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=test_refresh_secret_de_al_menos_32_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_test_dummy_0000000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_dummy_0000000000000000000000000000

MAIL_HOST=smtp.test.local
MAIL_PORT=2525
MAIL_USER=test
MAIL_PASS=test
MAIL_FROM=NexCom <noreply@nexcom.bo>

FRONTEND_URL=http://localhost:3000

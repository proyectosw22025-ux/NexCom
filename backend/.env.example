# ══════════════════════════════════════════════════════════
# NEXCOM BACKEND — VARIABLES DE ENTORNO
# Copiar a .env y completar con valores reales
# NUNCA subir el .env al repositorio
# ══════════════════════════════════════════════════════════

NODE_ENV=production

# ── Base de datos (Neon PostgreSQL) ──────────────────────
# Obtener en: https://console.neon.tech → Tu proyecto → Connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/nexcom_prod?sslmode=require

# ── Cache (Upstash Redis) ─────────────────────────────────
# Obtener en: https://console.upstash.com → Tu base de datos → Connection string (ioredis)
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ── JWT ──────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_esto_por_un_valor_aleatorio_de_64_caracteres_minimo
JWT_REFRESH_SECRET=cambia_esto_por_otro_valor_aleatorio_diferente_al_anterior
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe (Sandbox) ──────────────────────────────────────
# Obtener en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_AQUI
# Obtener en: https://dashboard.stripe.com/test/webhooks → Tu endpoint
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRET_AQUI

# ── Email (Mailtrap Sandbox) ──────────────────────────────
# Obtener en: https://mailtrap.io → Inbox → SMTP Settings
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=TU_USUARIO_MAILTRAP
MAIL_PASS=TU_PASSWORD_MAILTRAP
MAIL_FROM=NexCom <noreply@nexcom.bo>

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=https://nexcom-tuequipo.vercel.app
GRAPHQL_PATH=/graphql

# ── Cache TTLs (segundos) ─────────────────────────────────
CACHE_TTL_PRODUCTO=300
CACHE_TTL_CATALOGO=180
CACHE_TTL_BUSQUEDA=60
CACHE_TTL_CATEGORIAS=3600
CACHE_TTL_OFERTAS=30

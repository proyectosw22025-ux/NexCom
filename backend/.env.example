# ══════════════════════════════════════════════════════════════
# NEXCOM BACKEND — VARIABLES DE ENTORNO
# Copia este archivo como ".env" y completa los valores reales
# NUNCA subas el archivo ".env" al repositorio Git
# ══════════════════════════════════════════════════════════════

# ── ENTORNO ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── POSTGRESQL (instalación nativa PostgreSQL 17) ──────────────
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
# Reemplaza TU_PASSWORD con la contraseña que pusiste al instalar PostgreSQL
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/nexcom_dev"

# ── REDIS (instalación nativa) ──────────────────────────────────
# Si Redis no tiene contraseña (instalación local por defecto):
REDIS_URL="redis://localhost:6379"
# Si Redis SÍ tiene contraseña, usar:
# REDIS_URL="redis://:TU_PASSWORD_REDIS@localhost:6379"

# ── JWT ─────────────────────────────────────────────────────────
# Genera un string seguro de 64 caracteres. En PowerShell:
# -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | % {[char]$_})
JWT_ACCESS_SECRET="CAMBIAR_POR_STRING_ALEATORIO_64_CARACTERES_ACCESS"
JWT_REFRESH_SECRET="CAMBIAR_POR_STRING_ALEATORIO_64_CARACTERES_REFRESH"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── STRIPE (Sandbox — modo de prueba) ───────────────────────────
# Obtén estas claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_TU_CLAVE_SECRETA_DE_STRIPE"
STRIPE_WEBHOOK_SECRET="whsec_TU_CLAVE_WEBHOOK_DE_STRIPE_CLI"

# ── EMAIL (Nodemailer) ──────────────────────────────────────────
# Opción 1 — Mailtrap (recomendado para desarrollo, no envía emails reales):
# Crea cuenta en https://mailtrap.io → Inbox → Credenciales SMTP
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER="TU_USUARIO_MAILTRAP"
MAIL_PASS="TU_PASSWORD_MAILTRAP"
MAIL_FROM="NexCom <noreply@nexcom.bo>"

# ── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── GRAPHQL ──────────────────────────────────────────────────────
GRAPHQL_PATH="/graphql"

# ── CACHÉ TTL (en segundos) ──────────────────────────────────────
CACHE_TTL_PRODUCTO=300
CACHE_TTL_CATALOGO=180
CACHE_TTL_BUSQUEDA=60
CACHE_TTL_CATEGORIAS=3600
CACHE_TTL_OFERTAS=30

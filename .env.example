# ══════════════════════════════════════════════════════════
# NEXCOM — Variables para Docker Compose (raíz del proyecto)
# Copiar a `.env` (no se versiona) antes de levantar el stack:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════

# ── Postgres (docker-compose.yml) ─────────────────────────
POSTGRES_DB=nexcom
POSTGRES_USER=nexcom
POSTGRES_PASSWORD=nexcom

# ── Build-time del frontend (docker-compose.full.yml) ──────
# Se incrustan en el bundle del navegador durante `next build`.
# El backend publica el puerto 4000 al host, por lo que
# "localhost:4000" es accesible desde el navegador del usuario.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Copiar el valor real de frontend/.env.local (clave pública pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
